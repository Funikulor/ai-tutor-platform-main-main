<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="definitions_AdaptEd_ASIS_Admin"
             targetNamespace="http://adapted.local/bpmn"
             exporter="AdaptEd Diploma"
             exporterVersion="1.0">
  <process id="Process_AdaptEd_ASIS_Admin" name="AdaptEd AS-IS: Администрирование и начальная настройка" isExecutable="false">
    <documentation>Текущий процесс администрирования: создание админа (скрипт), заполнение БД из seed_credentials, управление пользователями и контентом.</documentation>
    <startEvent id="Start_Admin" name="Старт (развёртывание/настройка)"/>
    <task id="Task_CreateAdmin" name="Создание администратора (scripts/create_admin.py)"/>
    <task id="Task_SeedFromFile" name="Заполнение БД из seed_credentials.txt (scripts/seed_from_credentials.py)"/>
    <task id="Task_AdminLogin" name="Вход админа (auth/login)"/>
    <exclusiveGateway id="GW_NeedUsers" name="Нужно заполнить пользователей?"/>
    <task id="Task_ManageUsers" name="Управление пользователями (admin/users, CRUD, пароли)"/>
    <task id="Task_ManageContent" name="Управление структурой контента (предметы, разделы, темы)"/>
    <task id="Task_ViewStats" name="Просмотр статистики (admin/stats, аналитика)"/>
    <endEvent id="End_Admin" name="Конец"/>

    <sequenceFlow id="af1" sourceRef="Start_Admin" targetRef="Task_CreateAdmin"/>
    <sequenceFlow id="af2" sourceRef="Task_CreateAdmin" targetRef="Task_SeedFromFile"/>
    <sequenceFlow id="af3" sourceRef="Task_SeedFromFile" targetRef="Task_AdminLogin"/>
    <sequenceFlow id="af4" sourceRef="Task_AdminLogin" targetRef="GW_NeedUsers"/>
    <sequenceFlow id="af5" sourceRef="GW_NeedUsers" targetRef="Task_ManageUsers" name="Да"/>
    <sequenceFlow id="af6" sourceRef="GW_NeedUsers" targetRef="Task_ManageContent" name="Нет"/>
    <sequenceFlow id="af7" sourceRef="Task_ManageUsers" targetRef="Task_ManageContent"/>
    <sequenceFlow id="af8" sourceRef="Task_ManageContent" targetRef="Task_ViewStats"/>
    <sequenceFlow id="af9" sourceRef="Task_ViewStats" targetRef="End_Admin"/>
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_ASIS_Admin">
    <bpmndi:BPMNPlane bpmnElement="Process_AdaptEd_ASIS_Admin">
      <bpmndi:BPMNShape bpmnElement="Start_Admin" id="Shape_Start_Admin">
        <dc:Bounds x="152" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_CreateAdmin" id="Shape_Task_CreateAdmin">
        <dc:Bounds x="240" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_SeedFromFile" id="Shape_Task_SeedFromFile">
        <dc:Bounds x="380" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_AdminLogin" id="Shape_Task_AdminLogin">
        <dc:Bounds x="520" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="GW_NeedUsers" id="Shape_GW_NeedUsers">
        <dc:Bounds x="665" y="95" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_ManageUsers" id="Shape_Task_ManageUsers">
        <dc:Bounds x="760" y="40" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_ManageContent" id="Shape_Task_ManageContent">
        <dc:Bounds x="760" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_ViewStats" id="Shape_Task_ViewStats">
        <dc:Bounds x="900" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="End_Admin" id="Shape_End_Admin">
        <dc:Bounds x="1042" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="af1" id="Edge_af1"><di:waypoint x="188" y="120"/><di:waypoint x="240" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="af2" id="Edge_af2"><di:waypoint x="340" y="120"/><di:waypoint x="380" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="af3" id="Edge_af3"><di:waypoint x="480" y="120"/><di:waypoint x="520" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="af4" id="Edge_af4"><di:waypoint x="620" y="120"/><di:waypoint x="665" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="af5" id="Edge_af5"><di:waypoint x="690" y="95"/><di:waypoint x="760" y="80"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="af6" id="Edge_af6"><di:waypoint x="715" y="145"/><di:waypoint x="760" y="200"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="af7" id="Edge_af7"><di:waypoint x="810" y="120"/><di:waypoint x="810" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="af8" id="Edge_af8"><di:waypoint x="860" y="200"/><di:waypoint x="950" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="af9" id="Edge_af9"><di:waypoint x="1000" y="120"/><di:waypoint x="1042" y="120"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
