<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="definitions_AdaptEd_ASIS"
             targetNamespace="http://adapted.local/bpmn"
             exporter="AdaptEd Diploma"
             exporterVersion="1.0">
  <process id="Process_AdaptEd_ASIS" name="AdaptEd AS-IS: Текущие процессы платформы" isExecutable="false">
    <documentation>Диаграмма AS-IS дипломного проекта AdaptEd: адаптивная платформа с ИИ-репетитором. Отражает текущее состояние процессов обучения, авторизации и администрирования.</documentation>
    <!-- ========== Участник: Ученик ========== -->
    <startEvent id="Start_1" name="Старт (вход в платформу)"/>
    <task id="Task_Login" name="Вход в систему (auth/login)"/>
    <task id="Task_ChooseSection" name="Выбор раздела/темы обучения"/>
    <task id="Task_RequestTask" name="Запрос адаптивного задания (generate-adaptive-task)"/>
    <exclusiveGateway id="GW_TaskReceived" name="Задание получено?"/>
    <task id="Task_ShowQuestion" name="Показать задание ученику"/>
    <task id="Task_EnterAnswer" name="Ученик вводит ответ (число/дробь или текст)"/>
    <task id="Task_SubmitAnswer" name="Отправка ответа (submit-task)"/>
    <!-- ========== Участник: Система (бэкенд/ИИ) ========== -->
    <task id="Task_CheckAnswer" name="Проверка ответа (числовое сравнение / анализ)"/>
    <exclusiveGateway id="GW_Correct" name="Ответ верный?"/>
    <task id="Task_UpdateProfile" name="Обновление когнитивного профиля (mastery)"/>
    <task id="Task_AnalyzeError" name="Анализ ошибки (error_analyzer_agent)"/>
    <task id="Task_ShowResult" name="Показать результат: объяснение, правильный ответ, сообщение наставника"/>
    <endEvent id="End_1" name="Конец (повтор или выход)"/>
    <task id="Task_ErrorRetry" name="Повтор запроса / сообщение об ошибке"/>

    <sequenceFlow id="flow_1" sourceRef="Start_1" targetRef="Task_Login"/>
    <sequenceFlow id="flow_2" sourceRef="Task_Login" targetRef="Task_ChooseSection"/>
    <sequenceFlow id="flow_3" sourceRef="Task_ChooseSection" targetRef="Task_RequestTask"/>
    <sequenceFlow id="flow_4" sourceRef="Task_RequestTask" targetRef="GW_TaskReceived"/>
    <sequenceFlow id="flow_5" sourceRef="GW_TaskReceived" targetRef="Task_ShowQuestion" name="Да"/>
    <sequenceFlow id="flow_5b" sourceRef="GW_TaskReceived" targetRef="Task_ErrorRetry" name="Нет"/>
    <sequenceFlow id="flow_6" sourceRef="Task_ErrorRetry" targetRef="End_1"/>
    <sequenceFlow id="flow_7" sourceRef="Task_ShowQuestion" targetRef="Task_EnterAnswer"/>
    <sequenceFlow id="flow_8" sourceRef="Task_EnterAnswer" targetRef="Task_SubmitAnswer"/>
    <sequenceFlow id="flow_9" sourceRef="Task_SubmitAnswer" targetRef="Task_CheckAnswer"/>
    <sequenceFlow id="flow_10" sourceRef="Task_CheckAnswer" targetRef="GW_Correct"/>
    <sequenceFlow id="flow_11" sourceRef="GW_Correct" targetRef="Task_UpdateProfile" name="Да"/>
    <sequenceFlow id="flow_12" sourceRef="GW_Correct" targetRef="Task_AnalyzeError" name="Нет"/>
    <sequenceFlow id="flow_13" sourceRef="Task_UpdateProfile" targetRef="Task_ShowResult"/>
    <sequenceFlow id="flow_14" sourceRef="Task_AnalyzeError" targetRef="Task_ShowResult"/>
    <sequenceFlow id="flow_15" sourceRef="Task_ShowResult" targetRef="End_1"/>
  </process>

  <!-- Диаграмма AS-IS: расположение элементов -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_ASIS">
    <bpmndi:BPMNPlane bpmnElement="Process_AdaptEd_ASIS">
      <bpmndi:BPMNShape bpmnElement="Start_1" id="Shape_Start_1">
        <dc:Bounds x="152" y="82" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="140" y="125" width="60" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_Login" id="Shape_Task_Login">
        <dc:Bounds x="240" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_ChooseSection" id="Shape_Task_ChooseSection">
        <dc:Bounds x="380" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_RequestTask" id="Shape_Task_RequestTask">
        <dc:Bounds x="520" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="GW_TaskReceived" id="Shape_GW_TaskReceived">
        <dc:Bounds x="665" y="75" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_ShowQuestion" id="Shape_Task_ShowQuestion">
        <dc:Bounds x="760" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_EnterAnswer" id="Shape_Task_EnterAnswer">
        <dc:Bounds x="900" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_SubmitAnswer" id="Shape_Task_SubmitAnswer">
        <dc:Bounds x="1040" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_CheckAnswer" id="Shape_Task_CheckAnswer">
        <dc:Bounds x="1180" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="GW_Correct" id="Shape_GW_Correct">
        <dc:Bounds x="1325" y="75" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_UpdateProfile" id="Shape_Task_UpdateProfile">
        <dc:Bounds x="1420" y="20" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_AnalyzeError" id="Shape_Task_AnalyzeError">
        <dc:Bounds x="1420" y="130" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_ShowResult" id="Shape_Task_ShowResult">
        <dc:Bounds x="1560" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_ErrorRetry" id="Shape_Task_ErrorRetry">
        <dc:Bounds x="760" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="End_1" id="Shape_End_1">
        <dc:Bounds x="1712" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="flow_1" id="Edge_flow_1">
        <di:waypoint x="188" y="100"/>
        <di:waypoint x="240" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_2" id="Edge_flow_2">
        <di:waypoint x="340" y="100"/>
        <di:waypoint x="380" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_3" id="Edge_flow_3">
        <di:waypoint x="480" y="100"/>
        <di:waypoint x="520" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_4" id="Edge_flow_4">
        <di:waypoint x="620" y="100"/>
        <di:waypoint x="665" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_5" id="Edge_flow_5">
        <di:waypoint x="715" y="100"/>
        <di:waypoint x="760" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_5b" id="Edge_flow_5b">
        <di:waypoint x="690" y="125"/>
        <di:waypoint x="810" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_6" id="Edge_flow_6">
        <di:waypoint x="810" y="280"/>
        <di:waypoint x="1730" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_7" id="Edge_flow_7">
        <di:waypoint x="860" y="100"/>
        <di:waypoint x="900" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_8" id="Edge_flow_8">
        <di:waypoint x="1000" y="100"/>
        <di:waypoint x="1040" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_9" id="Edge_flow_9">
        <di:waypoint x="1140" y="100"/>
        <di:waypoint x="1180" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_10" id="Edge_flow_10">
        <di:waypoint x="1280" y="100"/>
        <di:waypoint x="1325" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_11" id="Edge_flow_11">
        <di:waypoint x="1350" y="60"/>
        <di:waypoint x="1420" y="60"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_12" id="Edge_flow_12">
        <di:waypoint x="1350" y="140"/>
        <di:waypoint x="1420" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_13" id="Edge_flow_13">
        <di:waypoint x="1520" y="60"/>
        <di:waypoint x="1560" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_14" id="Edge_flow_14">
        <di:waypoint x="1520" y="170"/>
        <di:waypoint x="1560" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_15" id="Edge_flow_15">
        <di:waypoint x="1660" y="100"/>
        <di:waypoint x="1712" y="100"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
