<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_StudentLearning"
  targetNamespace="http://adapted.local/bpmn">
  <bpmn:collaboration id="Collaboration_StudentLearning">
    <bpmn:participant id="Participant_StudentLearning" name="AdaptEd AS-IS: персонализированный цикл обучения ученика" processRef="Process_StudentLearning"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_StudentLearning" isExecutable="false">
    <bpmn:laneSet id="LaneSet_StudentLearning">
      <bpmn:lane id="Lane_Student" name="Ученик">
        <bpmn:flowNodeRef>StartEvent_RequestTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpenAdaptiveTab</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SolveTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitAnswer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewFeedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_LearningCycleClosed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Platform" name="Платформа AdaptEd">
        <bpmn:flowNodeRef>Task_LoadStudentContext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HasWeakTopic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectWeakTopic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectDefaultTopic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TopicSelected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowGeneratedTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckAnswer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsCorrect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowPositiveResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowExplanationAndMaterials</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AIAnalytics" name="AI и аналитика">
        <bpmn:flowNodeRef>Task_GenerateAdaptiveTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateProfileAfterSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClassifyError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateProfileAfterError</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_RequestTask" name="Нужно новое задание"/>
    <bpmn:task id="Task_OpenAdaptiveTab" name="Открыть раздел адаптивных заданий"/>
    <bpmn:task id="Task_LoadStudentContext" name="Загрузить профиль, слабые темы и интересы"/>
    <bpmn:exclusiveGateway id="Gateway_HasWeakTopic" name="Есть слабая тема?"/>
    <bpmn:task id="Task_SelectWeakTopic" name="Выбрать самую слабую тему"/>
    <bpmn:task id="Task_SelectDefaultTopic" name="Использовать тему по умолчанию"/>
    <bpmn:exclusiveGateway id="Gateway_TopicSelected" name="Тема определена"/>
    <bpmn:task id="Task_GenerateAdaptiveTask" name="Сгенерировать адаптивное задание"/>
    <bpmn:task id="Task_ShowGeneratedTask" name="Показать задание и краткое объяснение"/>
    <bpmn:task id="Task_SolveTask" name="Решить задание"/>
    <bpmn:task id="Task_SubmitAnswer" name="Отправить ответ"/>
    <bpmn:task id="Task_CheckAnswer" name="Проверить ответ"/>
    <bpmn:exclusiveGateway id="Gateway_IsCorrect" name="Ответ верный?"/>
    <bpmn:task id="Task_UpdateProfileAfterSuccess" name="Обновить mastery, очки и аналитику"/>
    <bpmn:task id="Task_ShowPositiveResult" name="Показать результат и следующий шаг"/>
    <bpmn:task id="Task_ClassifyError" name="Определить тип ошибки"/>
    <bpmn:task id="Task_UpdateProfileAfterError" name="Обновить профиль и рекомендации"/>
    <bpmn:task id="Task_ShowExplanationAndMaterials" name="Показать объяснение и материалы для повторения"/>
    <bpmn:task id="Task_ReviewFeedback" name="Изучить обратную связь и продолжить обучение"/>
    <bpmn:endEvent id="EndEvent_LearningCycleClosed" name="Цикл персонализации завершён"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_RequestTask" targetRef="Task_OpenAdaptiveTab"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_OpenAdaptiveTab" targetRef="Task_LoadStudentContext"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_LoadStudentContext" targetRef="Gateway_HasWeakTopic"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_HasWeakTopic" targetRef="Task_SelectWeakTopic" name="Да"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_HasWeakTopic" targetRef="Task_SelectDefaultTopic" name="Нет"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_SelectWeakTopic" targetRef="Gateway_TopicSelected"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_SelectDefaultTopic" targetRef="Gateway_TopicSelected"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_TopicSelected" targetRef="Task_GenerateAdaptiveTask"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_GenerateAdaptiveTask" targetRef="Task_ShowGeneratedTask"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ShowGeneratedTask" targetRef="Task_SolveTask"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_SolveTask" targetRef="Task_SubmitAnswer"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_SubmitAnswer" targetRef="Task_CheckAnswer"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_CheckAnswer" targetRef="Gateway_IsCorrect"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_IsCorrect" targetRef="Task_UpdateProfileAfterSuccess" name="Да"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_UpdateProfileAfterSuccess" targetRef="Task_ShowPositiveResult"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ShowPositiveResult" targetRef="Task_ReviewFeedback"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_IsCorrect" targetRef="Task_ClassifyError" name="Нет"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_ClassifyError" targetRef="Task_UpdateProfileAfterError"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_UpdateProfileAfterError" targetRef="Task_ShowExplanationAndMaterials"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_ShowExplanationAndMaterials" targetRef="Task_ReviewFeedback"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_ReviewFeedback" targetRef="EndEvent_LearningCycleClosed"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_StudentLearning">
    <bpmndi:BPMNPlane id="BPMNPlane_StudentLearning" bpmnElement="Collaboration_StudentLearning">
      <bpmndi:BPMNShape id="Participant_StudentLearning_di" bpmnElement="Participant_StudentLearning" isHorizontal="true">
        <dc:Bounds x="60" y="60" width="2540" height="510"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_Student_di" bpmnElement="Lane_Student" isHorizontal="true">
        <dc:Bounds x="90" y="60" width="2510" height="170"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Platform_di" bpmnElement="Lane_Platform" isHorizontal="true">
        <dc:Bounds x="90" y="230" width="2510" height="170"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AIAnalytics_di" bpmnElement="Lane_AIAnalytics" isHorizontal="true">
        <dc:Bounds x="90" y="400" width="2510" height="170"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_RequestTask_di" bpmnElement="StartEvent_RequestTask">
        <dc:Bounds x="140" y="127" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OpenAdaptiveTab_di" bpmnElement="Task_OpenAdaptiveTab">
        <dc:Bounds x="210" y="105" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LoadStudentContext_di" bpmnElement="Task_LoadStudentContext">
        <dc:Bounds x="390" y="275" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_HasWeakTopic_di" bpmnElement="Gateway_HasWeakTopic" isMarkerVisible="true">
        <dc:Bounds x="585" y="290" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SelectWeakTopic_di" bpmnElement="Task_SelectWeakTopic">
        <dc:Bounds x="700" y="245" width="135" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SelectDefaultTopic_di" bpmnElement="Task_SelectDefaultTopic">
        <dc:Bounds x="700" y="335" width="135" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_TopicSelected_di" bpmnElement="Gateway_TopicSelected" isMarkerVisible="true">
        <dc:Bounds x="905" y="290" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GenerateAdaptiveTask_di" bpmnElement="Task_GenerateAdaptiveTask">
        <dc:Bounds x="1010" y="445" width="145" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ShowGeneratedTask_di" bpmnElement="Task_ShowGeneratedTask">
        <dc:Bounds x="1210" y="275" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SolveTask_di" bpmnElement="Task_SolveTask">
        <dc:Bounds x="1415" y="105" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SubmitAnswer_di" bpmnElement="Task_SubmitAnswer">
        <dc:Bounds x="1590" y="105" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckAnswer_di" bpmnElement="Task_CheckAnswer">
        <dc:Bounds x="1765" y="275" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_IsCorrect_di" bpmnElement="Gateway_IsCorrect" isMarkerVisible="true">
        <dc:Bounds x="1940" y="290" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateProfileAfterSuccess_di" bpmnElement="Task_UpdateProfileAfterSuccess">
        <dc:Bounds x="2055" y="420" width="145" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ShowPositiveResult_di" bpmnElement="Task_ShowPositiveResult">
        <dc:Bounds x="2255" y="250" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ClassifyError_di" bpmnElement="Task_ClassifyError">
        <dc:Bounds x="2055" y="505" width="145" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateProfileAfterError_di" bpmnElement="Task_UpdateProfileAfterError">
        <dc:Bounds x="2255" y="420" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ShowExplanationAndMaterials_di" bpmnElement="Task_ShowExplanationAndMaterials">
        <dc:Bounds x="2255" y="335" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReviewFeedback_di" bpmnElement="Task_ReviewFeedback">
        <dc:Bounds x="2440" y="105" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LearningCycleClosed_di" bpmnElement="EndEvent_LearningCycleClosed">
        <dc:Bounds x="2520" y="127" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01">
        <di:waypoint x="176" y="145"/>
        <di:waypoint x="210" y="145"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
        <di:waypoint x="330" y="145"/>
        <di:waypoint x="460" y="145"/>
        <di:waypoint x="460" y="275"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03">
        <di:waypoint x="530" y="315"/>
        <di:waypoint x="585" y="315"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04">
        <di:waypoint x="635" y="315"/>
        <di:waypoint x="700" y="285"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05">
        <di:waypoint x="635" y="315"/>
        <di:waypoint x="700" y="375"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06">
        <di:waypoint x="835" y="285"/>
        <di:waypoint x="905" y="315"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07">
        <di:waypoint x="835" y="375"/>
        <di:waypoint x="905" y="315"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08">
        <di:waypoint x="955" y="315"/>
        <di:waypoint x="1010" y="485"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09">
        <di:waypoint x="1155" y="485"/>
        <di:waypoint x="1285" y="485"/>
        <di:waypoint x="1285" y="355"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1360" y="315"/>
        <di:waypoint x="1475" y="315"/>
        <di:waypoint x="1475" y="185"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1535" y="145"/>
        <di:waypoint x="1590" y="145"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="1710" y="145"/>
        <di:waypoint x="1825" y="145"/>
        <di:waypoint x="1825" y="275"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="1885" y="315"/>
        <di:waypoint x="1940" y="315"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14">
        <di:waypoint x="1990" y="315"/>
        <di:waypoint x="2127" y="315"/>
        <di:waypoint x="2127" y="420"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15">
        <di:waypoint x="2200" y="460"/>
        <di:waypoint x="2330" y="460"/>
        <di:waypoint x="2330" y="330"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16">
        <di:waypoint x="2405" y="290"/>
        <di:waypoint x="2440" y="145"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_17_di" bpmnElement="Flow_17">
        <di:waypoint x="1990" y="315"/>
        <di:waypoint x="2127" y="315"/>
        <di:waypoint x="2127" y="505"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_18_di" bpmnElement="Flow_18">
        <di:waypoint x="2200" y="545"/>
        <di:waypoint x="2330" y="545"/>
        <di:waypoint x="2330" y="500"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_19_di" bpmnElement="Flow_19">
        <di:waypoint x="2405" y="460"/>
        <di:waypoint x="2340" y="460"/>
        <di:waypoint x="2340" y="415"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_20_di" bpmnElement="Flow_20">
        <di:waypoint x="2425" y="375"/>
        <di:waypoint x="2505" y="375"/>
        <di:waypoint x="2505" y="185"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_21_di" bpmnElement="Flow_21">
        <di:waypoint x="2570" y="145"/>
        <di:waypoint x="2520" y="145"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
